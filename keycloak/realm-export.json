{
  "realm": "money-transfer",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Standard user role" },
      { "name": "ADMIN", "description": "Administrator role" }
    ]
  },
  "clients": [
    {
      "clientId": "money-transfer-client",
      "name": "Money Transfer Client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "attributes": {
        "access.token.lifespan": "3600"
      }
    },
    {
      "clientId": "money-transfer-service",
      "name": "Money Transfer Service (Confidential)",
      "enabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "money-transfer-secret",
      "redirectUris": ["*"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "money-transfer-service",
        "roles": ["manage-users", "view-users", "query-users"]
      }
    ]
  },
